# ===== Frontend environment variables =====
# Copy this file to  frontend/.env  and fill in real values.
# NOTE: Vite only reads .env at startup — restart `npm run dev` after editing.

# Where the backend API lives (local dev)
VITE_API_URL=http://localhost:5000/api

# Razorpay TEST key id (same rzp_test_ id as the backend)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Google OAuth Client ID (SAME id as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Group classes backend (talkwithshivah-classes-backend on Render).
# Local dev: the classes backend runs on port 5001.
VITE_CLASSES_API_URL=http://localhost:5001/api
